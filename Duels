            or inp.UserInputType == Enum.UserInputType.Touch then
            local d = inp.Position - _ds
            mainOuter.Position = UDim2.new(_sp.X.Scale, _sp.X.Offset + d.X, _sp.Y.Scale, _sp.Y.Offset + d.Y)
        end
    end)
end

